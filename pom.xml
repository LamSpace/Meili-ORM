<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.lamspace</groupId>
    <artifactId>meili-orm</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Meili-ORM</name>
    <description>Meilisearch Spring Boot starter: annotation-driven mapping, settings projection and templated operations (compatible with Spring Boot 3.5.x and 4.x).</description>
    <url>https://github.com/LamSpace/Meili-ORM</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:https://github.com/LamSpace/Meili-ORM.git</connection>
        <developerConnection>scm:git:git@github.com:LamSpace/Meili-ORM.git</developerConnection>
        <url>https://github.com/LamSpace/Meili-ORM</url>
    </scm>
    <developers>
        <developer>
            <id>lamspace</id>
            <name>LamSpace</name>
        </developer>
    </developers>
    <modules>
        <module>meili-orm-core</module>
        <module>meili-orm-spring-boot-autoconfigure</module>
        <module>meili-orm-spring-boot-starter</module>
        <module>meili-orm-serializer-jackson3</module>
        <module>meili-orm-repository</module>
        <module>meili-orm-testcontainers</module>
        <module>it</module>
        <module>examples</module>
    </modules>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <meilisearch-java.version>0.21.0</meilisearch-java.version>
        <okhttp.version>5.3.2</okhttp.version>
        <gson.version>2.13.2</gson.version>
        <jackson2.version>2.21.2</jackson2.version>
        <spring-boot.version>3.5.16</spring-boot.version><!-- compile baseline = lowest supported Boot generation -->
        <meili-server.version>v1.49.0</meili-server.version>
        <!-- Whether core's test-jar (inter-module test fixture) is attached to the build.
             True for ordinary builds; the release profile flips it to false so Central
             never sees a tests.jar. Gate runs under -Prelease must pass
             -Dmeili.test-jar.attach=true explicitly. -->
        <meili.test-jar.attach>true</meili.test-jar.attach>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- Explicit version pins take precedence over the BOM and align with the
                 transitive dependencies of meilisearch-java 0.21.0. The okhttp 5.x Maven artifact
                 is a multi-platform shell whose JVM classes live in okhttp-jvm (verified
                 empirically); both are pinned here and core depends on okhttp-jvm explicitly. -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>logging-interceptor</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.meilisearch.sdk</groupId>
                <artifactId>meilisearch-java</artifactId>
                <version>${meilisearch-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.lamspace</groupId>
                <artifactId>meili-orm-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.lamspace</groupId>
                <artifactId>meili-orm-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>io.github.lamspace</groupId>
                <artifactId>meili-orm-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.lamspace</groupId>
                <artifactId>meili-orm-serializer-jackson3</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.lamspace</groupId>
                <artifactId>meili-orm-repository</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.lamspace</groupId>
                <artifactId>meili-orm-testcontainers</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring convention: parameter-name resolution by annotations such as
                     @PathVariable/@RequestParam relies on the -parameters compiler flag
                     (default of the official Boot parent, which this repo does not inherit). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                </plugin>
                <plugin>
                    <groupId>com.mycila</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>5.1.2</version>
                    <configuration>
                        <licenseSets>
                            <licenseSet>
                                <header>${maven.multiModuleProjectDirectory}/etc/license-header.txt</header>
                                <includes>
                                    <include>src/main/java/**/*.java</include>
                                    <include>src/test/java/**/*.java</include>
                                </includes>
                            </licenseSet>
                        </licenseSets>
                        <mapping>
                            <java>SLASHSTAR_STYLE</java>
                        </mapping>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Private-member Javadoc gate: show=private surfaces missing Javadoc as a
                 doclint warning and failOnWarnings turns "missing = build failure" into a build fact. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <show>private</show>
                    <failOnWarnings>true</failOnWarnings>
                    <failOnError>true</failOnError>
                    <doclint>missing</doclint>
                    <release>${maven.compiler.release}</release>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-header-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Maven Central release profile: attaches sources and GPG signatures on top of the
             default build (the javadoc jar is already produced by build/plugins), then uploads
             via the Sonatype Central Portal. Publishing requires a `central` server entry in
             the active settings.xml (User Token) and an interactive GPG passphrase prompt. -->
        <profile>
            <id>release</id>
            <properties>
                <!-- The Central bundle must not carry core's tests.jar (pure inter-module
                     test fixture). Flipping attachment off keeps the file built in target/
                     while excluding it from install/deploy artifact lists. A gate run under
                     this profile that compiles test-jar consumers must restore attachment
                     with -Dmeili.test-jar.attach=true on the command line. -->
                <meili.test-jar.attach>false</meili.test-jar.attach>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <!-- Demo and compatibility-matrix modules are build-time-only and
                                 never ship: the plugin matches these by artifactId and leaves
                                 them out of the deployment bundle. maven.deploy.skip alone does
                                 not apply — this extension supersedes maven-deploy-plugin. -->
                            <excludeArtifacts>
                                <excludeArtifact>meili-orm-examples</excludeArtifact>
                                <excludeArtifact>meili-orm-example-common</excludeArtifact>
                                <excludeArtifact>meili-orm-example-boot3</excludeArtifact>
                                <excludeArtifact>meili-orm-example-boot4</excludeArtifact>
                                <excludeArtifact>meili-orm-it</excludeArtifact>
                                <excludeArtifact>meili-orm-it-boot3</excludeArtifact>
                                <excludeArtifact>meili-orm-it-boot4</excludeArtifact>
                                <excludeArtifact>meili-orm-it-boot4-jackson3</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
